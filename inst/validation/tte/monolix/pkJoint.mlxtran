<DATAFILE>

[FILEINFO]
file = '../data/pkJoint.csv'
delimiter = comma
header = {ID, TIME, EVID, AMT, CMT, DV, MDV, DVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
EVID = {use=eventidentifier}
MDV = {use=missingdependentvariable}
AMT = {use=amount}
CMT = {use=administration}
DV = {use=observation, name={y1, ev}, yname={'1', '2'}, type={continuous, event}}
DVID = {use=observationtype}

<MODEL>

[INDIVIDUAL]
input = {tcl_pop, omega_tcl, tv_pop, omega_tv, llam_pop, omega_llam, lic50_pop}

DEFINITION:
tcl = {distribution=normal, typical=tcl_pop, sd=omega_tcl}
tv = {distribution=normal, typical=tv_pop, sd=omega_tv}
llam = {distribution=normal, typical=llam_pop, sd=omega_llam}
lic50 = {distribution=normal, typical=lic50_pop, no-variability}

[LONGITUDINAL]
input = {b}

file = 'pkJoint_model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=cp, errorModel=proportional(b)}

<FIT>
data = {y1, ev}
model = {y1, ev}

<PARAMETER>
tcl_pop = {value=0.4054651, method=MLE}
tv_pop = {value=2.079442, method=MLE}
b = {value=0.2, method=MLE}
llam_pop = {value=-2.995732, method=MLE}
lic50_pop = {value=0, method=MLE}
omega_tcl = {value=0.4472136, method=MLE}
omega_tv = {value=0.4472136, method=MLE}
omega_llam = {value=0.3162278, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
seed = 1461
exportpath = 'pkJoint'
