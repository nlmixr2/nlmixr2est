$PROBLEM tte validation: hazard inhibited by a one-compartment PK model with known individual PK
$INPUT ID TIME EVID AMT CMT DV MDV DVID CLI VI
$DATA pkFixed.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=9
$MODEL COMP=(CENTRAL DEFDOSE) COMP=(CHZ)
$PK
  LLAM = THETA(1) + ETA(1)
  IC50 = EXP(THETA(2))
$DES
  CPD = A(1)/VI
  DADT(1) = -CLI/VI*A(1)
  DADT(2) = EXP(LLAM)*(1 - CPD/(IC50 + CPD))
$ERROR
  IF (NEWIND.NE.2) OLDCHZ = 0
  CHZ = A(2) - OLDCHZ
  IF (MDV.EQ.0) OLDCHZ = A(2)
  CP = A(1)/VI
  HAZ = EXP(LLAM)*(1 - CP/(IC50 + CP))
  Y = 2*CHZ
  IF (DV.EQ.1) Y = 2*CHZ - 2*LOG(HAZ)
$THETA -2.995732 ; llam
$THETA 0.4054651 ; lic50
$OMEGA 0.3 ; eta.lam
$ESTIMATION METHOD=CONDITIONAL LAPLACE NUMERICAL SLOW -2LL MAXEVAL=9999 PRINT=5 NOABORT
$COVARIANCE PRINT=E UNCONDITIONAL
