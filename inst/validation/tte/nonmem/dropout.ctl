$PROBLEM tte validation: single event with dropout as a competing process
; DVID 1 = event (CHZ1), DVID 2 = dropout (CHZ2)
$INPUT ID TIME EVID AMT CMT DV MDV DVID
$DATA dropout.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=9
$MODEL COMP=(CHZ1) COMP=(CHZ2)
$PK
  LH1 = THETA(1) + ETA(1)
  LH2 = THETA(2)
$DES
  DADT(1) = EXP(LH1)
  DADT(2) = EXP(LH2)
$ERROR
  IF (NEWIND.NE.2) THEN
    OLD1 = 0
    OLD2 = 0
  ENDIF
  CHZ = A(1) - OLD1
  HAZ = EXP(LH1)
  IF (DVID.EQ.2) CHZ = A(2) - OLD2
  IF (DVID.EQ.2) HAZ = EXP(LH2)
  IF (MDV.EQ.0.AND.DVID.EQ.1) OLD1 = A(1)
  IF (MDV.EQ.0.AND.DVID.EQ.2) OLD2 = A(2)
  Y = 2*CHZ
  IF (DV.EQ.1) Y = 2*CHZ - 2*LOG(HAZ)
$THETA -2.302585 ; lh1
$THETA -2.302585 ; lh2
$OMEGA 0.3 ; eta.h1
$ESTIMATION METHOD=CONDITIONAL LAPLACE -2LL MAXEVAL=9999 PRINT=5 NOABORT
$COVARIANCE PRINT=E UNCONDITIONAL
